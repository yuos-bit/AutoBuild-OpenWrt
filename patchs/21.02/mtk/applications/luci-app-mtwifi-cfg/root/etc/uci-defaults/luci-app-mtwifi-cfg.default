#!/bin/sh

# 首次开机确定性生成 /etc/config/wireless（不依赖 10-mtwifi-detect hotplug 时序）。
# 缺省会导致 LuCI「网络→无线」菜单因 depends uci.wireless.@wifi-device 为空而隐藏，
# 且 mt_wifi 驱动会退回自身默认配置（SSID 变成 Xiaomi-<MAC>）而非 UCI 里的配置。
if [ ! -e /etc/config/wireless ]; then
	/sbin/wifi config
	[ -e /etc/config/wireless ] && uci -q commit wireless
fi

# 生成后默认开启安全加密（psk2 + 1234567890），避免出现开放网络。
# SSID 名由 /etc/config/wireless 决定，可在 LuCI「网络→无线」里按需修改。
if [ -e /etc/config/wireless ]; then
	uci -q show wireless | sed -n 's/^wireless\.\([^.]*\)=wifi-iface$/\1/p' | while read _wifi_iface; do
		[ "$(uci -q get wireless.$_wifi_iface.mode)" = "ap" ] || continue
		uci -q set wireless.$_wifi_iface.encryption="psk2"
		uci -q set wireless.$_wifi_iface.key="1234567890"
	done
	uci -q commit wireless
fi

if [ -d /www/luci-static/resources/view/network ]; then
	mv -f /usr/share/luci-app-mtwifi-cfg/wireless-mtk.js /www/luci-static/resources/view/network/wireless.js
fi

if [ -d /usr/share/luci/menu.d ]; then
	mv -f /usr/share/luci-app-mtwifi-cfg/luci-mod-status.json /usr/share/luci/menu.d/luci-mod-status.json
fi

luci_network_js="/www/luci-static/resources/network.js"

if [ -f $luci_network_js ]; then
	if ! grep -sq 'ra\[xiyez\]' $luci_network_js ; then
		sed -i 's#/^wlan\\d+/,#/^wlan\\d+/,/^ra[xiyez]?\\d+/,/^apcli[xiyez]?\\d+/,#' $luci_network_js
	fi
fi
