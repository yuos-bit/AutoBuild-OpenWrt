From: AutoBuild-OpenWrt
Subject: [PATCH] mt_wifi: 让 WSC STA 两个私有 ioctl 常量对 AP 构建可见

sta_ioctl.c 报：

  sta_ioctl.c:287: error: 'RTPRIV_IOCTL_SET_WSC_PROFILE_U32_ITEM' undeclared
  sta_ioctl.c:295: error: 'RTPRIV_IOCTL_SET_WSC_PROFILE_STRING_ITEM' undeclared

两个常量原本定义在 rt_os.h，被三层条件包着：

  32  #ifndef _RT_OS_H_
  36  #if (KERNEL_VERSION(5, 6, 0) > LINUX_VERSION_CODE)   /* 整张 ioctl 常量表 */
  47    #ifdef CONFIG_STA_SUPPORT
  82      #ifdef WSC_STA_SUPPORT
  83      #define RTPRIV_IOCTL_SET_WSC_PROFILE_U32_ITEM    (SIOCIWFIRSTPRIV + 0x14)
  84      #define RTPRIV_IOCTL_SET_WSC_PROFILE_STRING_ITEM (SIOCIWFIRSTPRIV + 0x16)
  85      #endif
  86    #endif

而使用处（sta_ioctl.c 的私有 ioctl 表）只用 WSC_STA_SUPPORT 把关：

  #ifdef WSC_STA_SUPPORT
      RTPRIV_IOCTL_SET_WSC_PROFILE_U32_ITEM, ...

两者不一致，于是常量被 CONFIG_STA_SUPPORT 挡住而报未声明。（旁证：编译器的
"did you mean 'RTPRIV_IOCTL_WSC_PROFILE'" 说明 AP 段是活跃的，问题只出在
STA 段那道守卫。）

修法：把这两个常量移到文件末尾 —— 头文件保护之内、KERNEL_VERSION 块与
CONFIG_STA_SUPPORT 之外，只由 WSC_STA_SUPPORT 把关，与使用处一致。
这样无论最外层那个 KERNEL_VERSION 条件成立与否都可用。

ap_ioctl.c 里对这两个名字的引用都在注释中，不受影响。

--- a/mt_wifi/include/os/rt_os.h
+++ b/mt_wifi/include/os/rt_os.h
@@ -79,10 +79,6 @@
 
 
 
-#ifdef WSC_STA_SUPPORT
-#define RTPRIV_IOCTL_SET_WSC_PROFILE_U32_ITEM       (SIOCIWFIRSTPRIV + 0x14)
-#define RTPRIV_IOCTL_SET_WSC_PROFILE_STRING_ITEM    (SIOCIWFIRSTPRIV + 0x16)
-#endif /* WSC_STA_SUPPORT */
 #endif /* CONFIG_STA_SUPPORT */
 
 #ifdef CONFIG_AP_SUPPORT
@@ -172,4 +168,15 @@
 
 #endif
 
+/* WSC STA private ioctls.  mt_wifi_ap/Makefile defines WSC_STA_SUPPORT for
+ * CONFIG_MT_AP_SUPPORT builds too, while the original definitions sat behind
+ * CONFIG_STA_SUPPORT inside the KERNEL_VERSION < 5.6 block above, so
+ * sta_ioctl.c -- whose table is guarded by WSC_STA_SUPPORT alone -- could not
+ * see them.  Keep them last, inside the include guard but outside both, so
+ * they are available whenever WSC_STA_SUPPORT is set. */
+#ifdef WSC_STA_SUPPORT
+#define RTPRIV_IOCTL_SET_WSC_PROFILE_U32_ITEM       (SIOCIWFIRSTPRIV + 0x14)
+#define RTPRIV_IOCTL_SET_WSC_PROFILE_STRING_ITEM    (SIOCIWFIRSTPRIV + 0x16)
+#endif /* WSC_STA_SUPPORT */
+
 #endif /* _RT_OS_H_ */
