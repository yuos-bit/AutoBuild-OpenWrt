msgid "2.4 GHz stations are queried through the driver ioctl (mtwifi-sta), 5 GHz stations through nl80211. Click \"Kick\" to disconnect a client."
msgstr "2.4GHz 客户端通过驱动 ioctl（mtwifi-sta）查询，5GHz 通过 nl80211 查询。点击「剔除」可断开对应客户端。"

msgid "802.11k RRM"
msgstr "802.11k 无线资源测量"

msgid "A maximum of 16 MBSSID interfaces is supported."
msgstr "最多支持 16 个 MBSSID 接口。"

msgid "A-MSDU aggregation"
msgstr "A-MSDU 聚合"

msgid "Access Control"
msgstr "接入控制"

