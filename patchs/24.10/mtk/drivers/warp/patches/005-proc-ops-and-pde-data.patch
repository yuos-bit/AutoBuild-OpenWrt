+++ b/warp_utility.h
@@ -44,6 +44,7 @@
 #define WARP_FAIL_STATUS (-1)
 #define WARP_OK_STATUS (0)
 #define WARP_ALREADY_DONE_STATUS (1)
+#define PDE_DATA(i) pde_data(i)
 
